NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only name (no NEXT_PUBLIC_ prefix): avoids Vercel's "public prefix" warning. The old name NEXT_PUBLIC_SUPABASE_ANON_KEY still works as a fallback.
SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used to resolve Student IDs to emails.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
